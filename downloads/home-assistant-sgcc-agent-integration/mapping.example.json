{
  "alias": "home",
  "keep_days": 120,
  "daily_date_attribute": "last_reset",
  "yearly_counter_verified": false,
  "sources": {
    "daily": "sensor.last_electricity_usage_xxxx",
    "balance": "sensor.electricity_charge_balance_xxxx",
    "month_usage": "sensor.month_electricity_usage_xxxx",
    "month_charge": "sensor.month_electricity_charge_xxxx",
    "year_usage": "sensor.yearly_electricity_usage_xxxx",
    "year_charge": "sensor.yearly_electricity_charge_xxxx"
  }
}
