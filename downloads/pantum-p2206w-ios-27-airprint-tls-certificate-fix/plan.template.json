{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pantum P2206W iOS 27 AirPrint Compliance Plan",
  "version": "1.0.0",
  "target_device": "Pantum-P2206W",
  "network": {
    "printer_host": "192.168.1.xxx",
    "port": 443,
    "bonjour_service": "_ipp._tcp.local."
  },
  "compliance_policy": {
    "max_validity_days": 825,
    "enforce_san": true,
    "key_size": 2048,
    "algorithm": "sha256"
  },
  "certificate_payload": {
    "cn": "Pantum-******.local",
    "organization": "Local Printer",
    "export_format": "PKCS12",
    "passphrase": "******"
  },
  "deployment": {
    "auto_upload": true,
    "endpoint": "/docertificate",
    "verify_post_install": true
  }
}
